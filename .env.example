# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/milos_store

# JWT
JWT_SECRET=change-this-secret-in-production

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=milos-store-uploads
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_PUBLIC_URL=http://localhost:9000/milos-store-uploads

# App
PORT=3000

# CORS (comma-separated origins)
CORS_ORIGIN=http://localhost:3001,https://rariteti.rs

# Site URL (used for sitemap generation)
SITE_URL=https://rariteti.rs

# Google Indexing API (OAuth) — required for the Indexing API integration.
# Get these from Google Cloud Console → APIs & Services → Credentials.
# REDIRECT_URI must exactly match what's configured in the OAuth client.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://api.rariteti.rs/admin/indexing-oauth/callback

# Weekly Google Search Console coverage report (every Monday 07:00 UTC).
# Uses the same OAuth token as the Indexing API with the full webmasters scope —
# after deploying, re-run /admin/indexing-oauth/start so the consent screen grants
# both indexing AND webmasters access. The OAuth callback now auto-submits the
# sitemap to Search Console so you don't have to do it from the GSC UI.
GSC_REPORT_TO=
GSC_SITE_URL=https://rariteti.rs/
GSC_SITEMAP_URL=https://rariteti.rs/sitemap.xml

# SendGrid for outgoing mail (the report + any future transactional email).
# Free 100/day tier is fine for weekly reports. The From domain
# (rariteti.rs) is DKIM-authenticated independently from any other
# project sharing the SendGrid account — separate domain auth = separate
# DKIM keys = no reputation cross-contamination.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@rariteti.rs
SENDGRID_FROM_NAME=Rariteti.rs Indexing
