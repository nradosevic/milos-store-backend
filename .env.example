# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/milos_store

# JWT
JWT_SECRET=change-this-secret-in-production

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=milos-store-uploads
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_PUBLIC_URL=http://localhost:9000/milos-store-uploads

# App
PORT=3000

# CORS (comma-separated origins)
CORS_ORIGIN=http://localhost:3001,https://rariteti.rs

# Site URL (used for sitemap generation)
SITE_URL=https://rariteti.rs

# Google Indexing API (OAuth) — required for the Indexing API integration.
# Get these from Google Cloud Console → APIs & Services → Credentials.
# REDIRECT_URI must exactly match what's configured in the OAuth client.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://api.rariteti.rs/admin/indexing-oauth/callback
